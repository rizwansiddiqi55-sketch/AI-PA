# Copy to .env.local. Never commit real values.
DATABASE_URL=postgres://user:pass@localhost:5432/aipa
REDIS_URL=redis://localhost:6379
SESSION_SECRET=            # 32+ random bytes
TOKEN_ENCRYPTION_KEY=      # or KMS key id; encrypts OAuth tokens at rest
ANTHROPIC_API_KEY=         # server-side only
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
WHATSAPP_ACCESS_TOKEN=     # WhatsApp Business Platform (business numbers only)
FLIGHT_API_KEY=            # e.g. Amadeus / Duffel
APP_URL=http://localhost:3000   # public base URL; OAuth redirect URIs are APP_URL/api/oauth/callback/{google,microsoft}
OWNER_EMAIL=                    # your app account (single-owner mode)
ADMIN_BOOTSTRAP_TOKEN=          # 24+ random chars; the password for signing in to the app
MICROSOFT_TENANT=common         # common = personal (live.com/outlook.com/hotmail) + work; consumers = personal only
